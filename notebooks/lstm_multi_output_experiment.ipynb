   "source": [
    "monthly_df['rolling_mean_3'] = (\n",
    "    monthly_df.groupby('store_id')['sales_amount_realistic']\n",
    "    .rolling(3).mean().reset_index(0, drop=True)\n",
    ")\n",
    "\n",
    "monthly_df['rolling_mean_6'] = (\n",
    "    monthly_df.groupby('store_id')['sales_amount_realistic']\n",
    "    .rolling(6).mean().reset_index(0, drop=True)\n",
    ")"
   ]
  },
  {
