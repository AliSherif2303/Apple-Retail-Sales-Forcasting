   "source": [
    "monthly_df['month_sin'] = np.sin(2 * np.pi * monthly_df['month'] / 12)\n",
    "monthly_df['month_cos'] = np.cos(2 * np.pi * monthly_df['month'] / 12)"
   ]
  },
  {
   "cell_type": "code",
