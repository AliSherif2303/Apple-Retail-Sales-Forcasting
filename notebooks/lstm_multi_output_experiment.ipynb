   "outputs": [],
   "source": [
    "for lag in [1,3,6,12]:\n",
    "    monthly_df[f'lag_{lag}'] = (\n",
    "        monthly_df.groupby('store_id')['sales_amount_realistic']\n",
    "        .shift(lag)\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
