    "model = Sequential([\n",
    "    LSTM(256, return_sequences=True, input_shape=(12, len(feature_cols))),\n",
    "    Dropout(0.3),\n",
    "\n",
    "    LSTM(128, return_sequences=True),\n",
    "    Dropout(0.3),\n",
    "\n",
    "    LSTM(64),\n",
    "    Dropout(0.3),\n",
    "\n",
    "    Dense(64, activation='relu'),\n",
    "    Dense(32, activation='relu'),\n",
    "\n",
    "    Dense(12)   # predict 12 months\n",
    "])\n",
    "\n",
    "model.compile(\n",
    "    optimizer='adam',\n",
    "    loss='mse',\n",
    "    metrics=['mae']\n",
    ")\n",
    "\n",
    "model.summary()"
   ]
