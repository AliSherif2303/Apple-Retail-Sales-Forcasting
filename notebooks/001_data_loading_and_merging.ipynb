    "# === MERGE enriched macro data INTO cleaned_apple_sales ===\n",
    "\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import shutil\n",
    "\n",
    "# Resolve project root automatically\n",
    "PROJECT_ROOT = Path.cwd().parent.resolve()\n",
    "PROC = PROJECT_ROOT / \"data\" / \"processed\"\n",
    "\n",
    "print(\"Using processed folder:\", PROC)\n",
    "\n",
    "clean_path = PROC / \"cleaned_apple_sales.csv\"\n",
    "enriched_path = PROC / \"merged_apple_enriched.csv\"\n",
    "\n",
    "# Safety: Make backup of cleaned\n",
    "backup_path = PROC / \"cleaned_apple_sales_BACKUP.csv\"\n",
    "if not backup_path.exists():\n",
    "    shutil.copy2(clean_path, backup_path)\n",
    "    print(\"Backup created:\", backup_path)\n",
    "\n",
    "# Load datasets\n",
    "clean = pd.read_csv(clean_path, low_memory=False)\n",
    "enriched = pd.read_csv(enriched_path, low_memory=False)\n",
    "\n",
    "print(\"Clean shape:\", clean.shape)\n",
    "print(\"Enriched shape:\", enriched.shape)\n",
    "\n",
    "# Use sale_id as merge key\n",
    "if clean[\"sale_id\"].is_unique:\n",
    "    merge_key = \"sale_id\"\n",
    "    print(\"Merging on 'sale_id'\")\n",
    "else:\n",
    "    raise ValueError(\"sale_id is NOT unique — cannot merge safely!\")\n",
    "\n",
    "# Only take new macro columns from enriched\n",
    "clean_cols = set(clean.columns)\n",
    "new_macro_cols = [c for c in enriched.columns if c not in clean_cols and c != merge_key]\n",
    "\n",
    "enriched_sub = enriched[[merge_key] + new_macro_cols]\n",
    "\n",
    "# Perform merge\n",
    "combined = clean.merge(enriched_sub, how=\"left\", on=merge_key, validate=\"1:1\")\n",
    "print(\"Combined shape:\", combined.shape)\n",
    "\n",
    "# Save final enriched dataset\n",
    "out = PROC / \"cleaned_apple_sales_enriched.csv\"\n",
    "combined.to_csv(out, index=False)\n",
    "print(\"Saved final enriched dataset to:\", out)\n"
   ]
